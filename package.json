{
  "name": "pi-taskwatcher",
  "version": "0.3.0",
  "description": "Show any external process's progress as live chips in the Pi footer via a language-agnostic JSON file convention",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "progress",
    "status",
    "tasks"
  ],
  "pi": {
    "extensions": [
      "./taskwatcher.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelllc09/pi-taskwatcher.git"
  },
  "homepage": "https://github.com/codelllc09/pi-taskwatcher#readme",
  "bugs": "https://github.com/codelllc09/pi-taskwatcher/issues",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typebox": "*"
  },
  "scripts": {
    "test": "node tests/test-extension.mjs && node tests/test-hardening.mjs && node tests/test-e2e.mjs && node tests/test-isolation.mjs"
  },
  "files": [
    "taskwatcher.ts",
    "scripts/",
    "!scripts/__pycache__",
    "docs/",
    "tests/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  }
}